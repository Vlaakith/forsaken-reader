      { "text": "Девочка, девочка!" },
      { "text": "Гроб на колёсиках" },
      { "text": "выехал", "ru": "나왔다", "ex": "Выехал с кладбища — 묘지에서 나왔다" },
      { "text": "с" },
      { "text": "кладбища", "ru": "묘지", "ex": "Старое кладбище — 오래된 묘지" },
      { "text": "." }
    ],
    [
      { "text": "Девочка не поверила." },
      { "text": "Но голос" },
      { "text": "продолжает", "ru": "계속한다", "ex": "Голос продолжает говорить — 목소리가 계속 말한다" },
      { "text": "." },
      { "text": "Гроб на колёсиках нашёл твою" },
      { "text": "улицу", "ru": "거리", "ex": "Нашёл твою улицу — 네 거리를 찾았다" },
      { "text": "." },
      { "text": "Гроб на колёсиках нашёл твой" },
      { "text": "дом", "ru": "집", "ex": "Нашёл твой дом — 네 집을 찾았다" },
      { "text": "." },
      { "text": "Девочка" },
      { "text": "заперла", "ru": "잠갔다", "ex": "Заперла дверь — 문을 잠갔다" },
      { "text": "дверь." },
      { "text": "Но голос говорит: гроб на колёсиках" },
      { "text": "уже в квартире", "ru": "이미 집 안에 있다", "ex": "Он уже внутри — 이미 안에 있다" },
