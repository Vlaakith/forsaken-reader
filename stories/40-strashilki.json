    [
      { "text": "Таких историй были" },
      { "text": "сотни", "ru": "수백 개", "ex": "Сотни историй — 수백 개의 이야기" },
      { "text": "." },
      { "text": "Чёрная Рука." },
      { "text": "Зелёные Глаза." },
      { "text": "Красное" },
      { "text": "Пятно", "ru": "얼룩", "ex": "Красное пятно на стене — 벽에 빨간 얼룩" },
      { "text": "." },
      { "text": "Дети рассказывали их в" },
      { "text": "пионерских лагерях", "ru": "소련 여름 캠프", "ex": "Советский лагерь для детей — 소련 어린이 캠프" },
      { "text": "по ночам." },
      { "text": "Без" },
      { "text": "света", "ru": "빛", "ex": "Без света — 빛 없이" },
      { "text": ", без телефонов." },
      { "text": "Только" },
      { "text": "голоса", "ru": "목소리들", "ex": "Голоса в темноте — 어둠 속의 목소리들" },
      { "text": "в темноте." }
    ],
    [
      { "text": "Сейчас дети смотрят" },
      { "text": "хоррор", "ru": "공포 영상", "ex": "Смотреть хоррор — 공포 영상을 보다" },
      { "text": "на YouTube и играют в Forsaken." },
      { "text": "Но 50 лет" },
      { "text": "назад", "ru": "전에", "ex": "50 лет назад — 50년 전에" },
      { "text": "русские дети пугали друг друга" },
      { "text": "просто словами", "ru": "그냥 말로만", "ex": "Пугать словами — 말로 무섭게 하다" },
      { "text": "." },
      { "text": "Без" },
      { "text": "графики", "ru": "그래픽", "ex": "Без графики — 그래픽 없이" },
      { "text": "." },
      { "text": "Без звуков." },
      { "text": "Только" },
      { "text": "воображение", "ru": "상상력", "ex": "Сила воображения — 상상력의 힘" },
      { "text": "." }
    ]
  ]
